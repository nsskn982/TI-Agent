# --- Local PostgreSQL + pgvector (docker compose up -d) ---
POSTGRES_PASSWORD=ti_agent
DATABASE_URL=postgresql://ti_agent:ti_agent@127.0.0.1:5433/ti_agent

# --- Data sources ---
FINNHUB_API_KEY=
FRED_API_KEY=
# EDGAR requires "Name email" in the User-Agent
SEC_USER_AGENT=TI-Agent your-name your-email@example.com

# --- Ingestion tuning (optional) ---
# Comma-separated; overrides watchlist.txt
WATCHLIST=
MAX_FILING_CHARS=300000
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Agent ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=trading-analyst
OLLAMA_CONTEXT_LENGTH=16384
# Qwen3.5 reasons before answering; set false for faster, shallower runs
OLLAMA_THINK=true

# --- Delivery ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BENCHMARK=SPY
SENTIMENT_MODEL=ProsusAI/finbert

# --- Website (Django, web/) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# true only for local development (runserver); false when deployed
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Contact links on the website (leave LinkedIn empty to hide it)
CONTACT_LINKEDIN_URL=
CONTACT_GITHUB_URL=https://github.com/nsskn982
# Local quant API (uvicorn quant.api:app). Empty = answer requests from this machine only.
QUANT_API_TOKEN=
# true only behind a TLS-terminating proxy
DJANGO_BEHIND_PROXY=false

# --- App (Flutter on GitHub Pages) ---
# Encrypts site-data/data.json, which the app downloads and decrypts with this password.
# The file is public, so use a long random one and share it only with people who may read the app:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
APP_DATA_PASSWORD=
# Weekly S&P 500 screen: how many top picks get news, filings and AI suggestions
SCREEN_TOP_N=20
