# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# --- Data sources ---
FINNHUB_API_KEY=
FRED_API_KEY=
# EDGAR requires "Name email" in the User-Agent
SEC_USER_AGENT=TI-Agent your-name your-email@example.com

# --- Ingestion tuning (optional) ---
# Comma-separated; overrides watchlist.txt
WATCHLIST=
MAX_FILING_CHARS=300000
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Agent ---
OLLAMA_URL=http://localhost:11434

# --- Delivery ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BENCHMARK=SPY
SENTIMENT_MODEL=ProsusAI/finbert
